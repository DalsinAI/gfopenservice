# What ACMedia's FFmpeg is built with (design section 4.3): everything else
# stays disabled (--disable-everything). One "kind name" per line; a kind
# ending in -x86_64 or -aarch64 applies to that architecture only.
# Our codec tags for these are in src/acm_codecs.c; a decoder here without a
# tag there is never opened.

# Video, mainstream
decoder h264
decoder hevc
decoder libdav1d
decoder vp8
decoder vp9
decoder mpeg1video
decoder mpeg2video
decoder mpeg4
decoder h263
decoder msmpeg4v1
decoder msmpeg4v2
decoder msmpeg4v3
decoder wmv1
decoder wmv2
decoder wmv3
decoder vc1
decoder theora
decoder mjpeg
decoder prores
decoder ffv1
# Video, the CD-ROM era
decoder cinepak
decoder indeo3
decoder indeo4
decoder indeo5
decoder msvideo1
decoder msrle
decoder qtrle
decoder rpza
decoder smc
decoder svq1
decoder svq3
decoder flic
decoder smacker
decoder roq
# Amiga
decoder cdxl
decoder iff_ilbm
decoder anm
decoder eightsvx_fib
decoder eightsvx_exp
decoder pcm_s8
decoder pcm_s8_planar
# Audio
decoder mp1float
decoder mp2float
decoder mp3float
decoder aac
decoder aac_latm
decoder ac3
decoder eac3
decoder dca
decoder flac
decoder vorbis
decoder opus
decoder alac
decoder wmav1
decoder wmav2
decoder wavpack
decoder tta
decoder ape
decoder adpcm_ima_wav
decoder adpcm_ms
decoder smackaud
decoder pcm_s16le
decoder pcm_s16be
decoder pcm_s24le
decoder pcm_s24be
decoder pcm_s32le
decoder pcm_s32be
decoder pcm_u8
decoder pcm_f32le
decoder pcm_f32be
decoder pcm_alaw
decoder pcm_mulaw
# Subtitles (whether they are shown in v1 is Dale's Q4; built, so probe sees them)
decoder subrip
decoder ass
decoder ssa
decoder movtext
decoder webvtt
decoder dvdsub
decoder dvbsub
decoder pgssub
# Hardware
decoder-aarch64 h264_v4l2m2m
decoder-aarch64 hevc_v4l2m2m
hwaccel-aarch64 hevc_v4l2request
hwaccel-x86_64 h264_vaapi
hwaccel-x86_64 hevc_vaapi
hwaccel-x86_64 mpeg2_vaapi
hwaccel-x86_64 vc1_vaapi
hwaccel-x86_64 wmv3_vaapi
hwaccel-x86_64 vp9_vaapi
hwaccel-x86_64 av1_vaapi

# Demuxers
demuxer mov
demuxer matroska
demuxer avi
demuxer mpegps
demuxer mpegts
demuxer mpegvideo
demuxer h264
demuxer hevc
demuxer ogg
demuxer wav
demuxer w64
demuxer aiff
demuxer caf
demuxer au
demuxer voc
demuxer flac
demuxer mp3
demuxer aac
demuxer ac3
demuxer eac3
demuxer asf
demuxer flv
demuxer ivf
demuxer obu
demuxer ape
demuxer wv
demuxer tta
demuxer iff
demuxer cdxl
demuxer anm
demuxer flic
demuxer smacker
demuxer roq
demuxer srt
demuxer ass
demuxer webvtt
demuxer libopenmpt

# Parsers
parser h264
parser hevc
parser av1
parser vp8
parser vp9
parser mpeg4video
parser mpegvideo
parser mpegaudio
parser aac
parser aac_latm
parser ac3
parser dca
parser flac
parser vorbis
parser opus
parser mjpeg
parser dvdsub
parser dvbsub

# Bitstream filters the decoders and hwaccels need
bsf h264_mp4toannexb
bsf hevc_mp4toannexb
bsf vp9_superframe_split
bsf av1_frame_split
bsf extract_extradata
